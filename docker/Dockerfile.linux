# syntax=docker/dockerfile:1.7
# Hermetic Linux build: PyInstaller binary + .deb + .rpm for the *container's*
# platform. Select the arch with `--platform linux/amd64|linux/arm64`
# (arm64 on an x86 host runs under qemu-user/binfmt).
#
#   docker buildx build --platform linux/arm64 --build-arg VERSION=0.2.0 \
#       --target artifacts --output type=local,dest=dist -f docker/Dockerfile.linux .
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS build

# Qt/WebEngine shared libs must be present so PyInstaller can resolve them.
RUN apt-get update && apt-get install -y --no-install-recommends \
        binutils file make dpkg-dev rpm fakeroot ca-certificates \
        libatomic1 libxkbfile1 libgl1 libegl1 libglib2.0-0 libxkbcommon0 libxkbcommon-x11-0 \
        libfontconfig1 libdbus-1-3 libnss3 libnspr4 libasound2 \
        libxcomposite1 libxdamage1 libxrandr2 libxtst6 libxi6 libxfixes3 libxext6 \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xkb1 libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
WORKDIR /src
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip /opt/venv/bin/pip install -r requirements.txt

COPY . .
ARG VERSION=0.0.0
ARG SOURCE_DATE_EPOCH=0
ENV VENV=/opt/venv APP_NAME=qpwnagotchi VERSION=${VERSION} SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
RUN ./scripts/build.sh && ./scripts/build-deb.sh && ./scripts/build-rpm.sh \
    && ls -la dist

FROM scratch AS artifacts
COPY --from=build /src/dist/ /
