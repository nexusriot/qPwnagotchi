# Clean-machine install test: install the built .deb, then boot the real binary.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        libc6 libxkbcommon0 libfontconfig1 libgl1 libegl1 libdbus-1-3 libnss3 libatomic1 libxkbfile1 \
        libxcb-cursor0 libglib2.0-0 libnspr4 libasound2 libxcomposite1 libxdamage1 libxrandr2 \
        libxtst6 libxi6 libxfixes3 libxext6 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-xkb1 libxcb-xinerama0 \
    && rm -rf /var/lib/apt/lists/*
